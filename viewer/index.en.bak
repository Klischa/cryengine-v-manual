<script>
const q=document.getElementById('q'),nav=document.getElementById('nav'),c=document.getElementById('count');
const lis=[...nav.querySelectorAll('li')];
function filter(){
 const t=q.value.trim().toLowerCase();
 let shown=0;
 for(const li of lis) li.style.display='';
 if(t){
   // hide leaves not matching; keep ancestors of matches
   const all=[...nav.querySelectorAll('li')];
   for(const li of all) li.dataset.keep='';
   for(const li of all){
     const match=(li.dataset.title||'').includes(t);
     if(match){ li.dataset.keep='1'; let p=li.parentElement.closest('li'); while(p){p.dataset.keep='1';p=p.parentElement.closest('li');} }
   }
   for(const li of all){ if(li.dataset.keep!=='1') li.style.display='none'; else shown++; }
   c.textContent=shown+'/'+all.length;
 } else c.textContent='';
}
q.addEventListener('input',filter);
</script>
</body></html>