macroScript zeroOut
	category:"cryTools"
	--variation of Michael Comet's script, changed, and updated for Max7

(

    objs = getCurrentSelection();
	oc = objs.count;

    undo "ZEROOut" on (
	
	    setWaitCursor();

		for i in 1 to oc do 
		    (
			pt = Point pos:[0,0,0] size:20;
			pt.parent = objs[i].parent;
			coordsys world 
				(
				pt.scale = objs[i].scale;
				pt.rotation = objs[i].rotation;
				pt.position = objs[i].position;
				pt.wirecolor = (color 80 10 0);
				pt.name = (objs[i].name+"ZERO");
				)
			objs[i].parent = pt;
		    )
		select objs;

		setArrowCursor();
		)
	
)

